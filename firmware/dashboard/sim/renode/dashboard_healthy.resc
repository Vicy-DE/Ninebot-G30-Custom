:name: G30 dashboard — healthy run on the REAL firmware (Renode)
:description: ADC1_SR is pre-set so adc_read() succeeds -> every required
:description: subsystem stays fresh -> the firmware keeps feeding the IWDG ->
:description: the watchdog never fires. Exactly ONE [BOOT] in the whole run.
using sysbus
$repo ?= @C:/Users/Layer/Documents/Ninebot-G30-Custom
logLevel 3

mach create "g30-dash"
machine LoadPlatformDescription @platforms/cpus/stm32f103.repl
machine LoadPlatformDescription $repo/firmware/dashboard/sim/renode/dash_overlay.repl
machine LoadPlatformDescription $repo/firmware/dashboard/sim/renode/dash_adc.repl
sysbus LoadELF $repo/firmware/dashboard/build/dashboard_app.elf

# ADC1_SR.EOC = 1 → conversions "complete" → ADC subsystem stays healthy.
sysbus WriteDoubleWord 0x40012400 0x00000002
# Reset-vector mirror (same as the watchdog script) in case of any reset.
$sp ?= 0x20005000
$resetpc ?= 0x080010ED
sysbus WriteDoubleWord 0x00000000 $sp
sysbus WriteDoubleWord 0x00000004 $resetpc

sysbus.usart2 CreateFileBackend $repo/firmware/dashboard/sim/renode/usart2_healthy.log true

emulation RunFor "00:00:13"
quit
