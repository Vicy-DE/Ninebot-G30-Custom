// Renode platform overlay for the G30 dashboard firmware.
// Loaded on top of the built-in `platforms/cpus/stm32f103.repl`, it adds the
// independent watchdog (IWDG) the base platform lacks, plus read-only tags for
// the RCC ready/status bits the firmware busy-waits on during clock_init().
//
//   IWDG @ 0x40003000, LSI 40 kHz  → PR=4/RLR=3124 give a real 5000 ms timeout.
//   RCC_CFGR SWS = PLL  (so the "switch to PLL" wait completes)
//   RCC_CSR  LSIRDY = 1 (so the "LSI ready" wait completes)

iwdg: Timers.STM32_IndependentWatchdog @ sysbus 0x40003000
    frequency: 40000

sysbus:
    init add:
        Tag <0x40021004, 0x40021007> "RCC_CFGR_SWS_PLL" 0x00000008
        Tag <0x40021024, 0x40021027> "RCC_CSR_LSIRDY" 0x00000003
