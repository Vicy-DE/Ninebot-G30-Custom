:name: G30 dashboard — UART protocol confirmation on the REAL firmware (Renode)
:description: Inject a Ninebot 0x64 display frame on USART2 (battery=0x50=80), then a
:description: phone-app READ of ESC reg 0x22 on USART1, and capture the firmware's
:description: response. Expected on USART1: 5A A5 02 20 3E 04 22 50 00 29 FF
using sysbus
$repo ?= @C:/Users/Layer/Documents/Ninebot-G30-Custom
logLevel 3

mach create "g30-dash"
machine LoadPlatformDescription @platforms/cpus/stm32f103.repl
machine LoadPlatformDescription $repo/firmware/dashboard/sim/renode/dash_overlay.repl
machine LoadPlatformDescription $repo/firmware/dashboard/sim/renode/dash_adc.repl
sysbus LoadELF $repo/firmware/dashboard/build/dashboard_app.elf
sysbus WriteDoubleWord 0x40012400 0x00000002      # ADC healthy (EOC set)
$sp ?= 0x20005000
$resetpc ?= 0x080010ED
sysbus WriteDoubleWord 0x00000000 $sp
sysbus WriteDoubleWord 0x00000004 $resetpc

sysbus.usart1 CreateFileBackend $repo/firmware/dashboard/sim/renode/usart1_proto.log true

emulation RunFor "00:00:00.6"                      # boot into the main loop

# VESC -> dash: 0x64 display frame, payload [mode=0 batt=0x50 light=1 beep=0 speed=0x0A err=0]
# 5A A5 06 20 21 64 00 00 50 01 00 0A 00 F9 FE
sysbus.usart2 WriteChar 0x5A
sysbus.usart2 WriteChar 0xA5
sysbus.usart2 WriteChar 0x06
sysbus.usart2 WriteChar 0x20
sysbus.usart2 WriteChar 0x21
sysbus.usart2 WriteChar 0x64
sysbus.usart2 WriteChar 0x00
sysbus.usart2 WriteChar 0x00
sysbus.usart2 WriteChar 0x50
sysbus.usart2 WriteChar 0x01
sysbus.usart2 WriteChar 0x00
sysbus.usart2 WriteChar 0x0A
sysbus.usart2 WriteChar 0x00
sysbus.usart2 WriteChar 0xF9
sysbus.usart2 WriteChar 0xFE
emulation RunFor "00:00:00.3"

# Phone(App 0x3E) -> ESC 0x20: READ reg 0x22, 2 bytes.  5A A5 01 3E 20 01 22 02 7B FF
sysbus.usart1 WriteChar 0x5A
sysbus.usart1 WriteChar 0xA5
sysbus.usart1 WriteChar 0x01
sysbus.usart1 WriteChar 0x3E
sysbus.usart1 WriteChar 0x20
sysbus.usart1 WriteChar 0x01
sysbus.usart1 WriteChar 0x22
sysbus.usart1 WriteChar 0x02
sysbus.usart1 WriteChar 0x7B
sysbus.usart1 WriteChar 0xFF
emulation RunFor "00:00:00.4"

quit
